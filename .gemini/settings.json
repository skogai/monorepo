{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "cwd": "/home/skogix/Work",
      "env": {
        "CRG_OPENAI_BASE_URL": "http://127.0.0.1:1234/v1",
        "CRG_OPENAI_API_KEY": "lm-studio",
        "CRG_OPENAI_MODEL": "text-embedding-nomic-embed-text-v1.5-embedding",
        "CRG_VECTOR_CACHE": "1"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/crg-session-start.sh",
            "name": "code-review-graph status",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/crg-update.sh",
            "name": "code-review-graph update",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
