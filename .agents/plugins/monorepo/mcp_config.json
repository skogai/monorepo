{
  "mcpServers": {
    "mise": {
      "command": "mise",
      "args": [
        "--cd",
        "/home/skogix/Work",
        "mcp"
      ]
    },
    "atuin": {
      "command": "atuin",
      "args": [
        "mcp"
      ]
    },
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve",
        "--repo",
        "/home/skogix/Work"
      ],
      "env": {
        "CRG_OPENAI_BASE_URL": "http://127.0.0.1:1234/v1",
        "CRG_OPENAI_API_KEY": "lm-studio",
        "CRG_OPENAI_MODEL": "text-embedding-nomic-embed-text-v1.5-embedding",
        "CRG_VECTOR_CACHE": "1"
      }
    }
  }
}
