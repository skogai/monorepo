{
  "code-review-graph": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./hooks/crg-session-start.sh",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/crg-update.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
