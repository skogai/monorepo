[Unit]
Description=SkogAI shared T3 Code backend

[Service]
WorkingDirectory=%h/Work/t3
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env mise run //:t3:serve
Restart=on-failure
RestartSec=3
UMask=0077
# T3 serve prints a pairing token and QR code at startup.
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
